@model Klient
<h2>Dane klienta</h2><div class="card karta"><div class="card-body"><h4>@Model.Imie @Model.Nazwisko</h4><p><b>Telefon:</b> @Model.Telefon</p><p><b>E-mail:</b> @Model.Email</p><p><b>Miasto:</b> @Model.Miasto</p><p><b>Dodano:</b> @Model.DataDodania.ToString("dd.MM.yyyy HH:mm")</p><a asp-action="Edytuj" asp-route-id="@Model.Id" class="btn btn-warning">Edytuj</a> <a asp-action="Index" class="btn btn-secondary">Powrót</a></div></div>
