@model IEnumerable<Klient>
<div class="d-flex justify-content-between align-items-center mb-3"><h2>Klienci</h2><a asp-action="Dodaj" class="btn btn-success">Dodaj klienta</a></div>
<form method="get" class="row g-2 mb-3"><div class="col-md-8"><input name="szukaj" value="@ViewBag.Szukaj" class="form-control" placeholder="Szukaj po imieniu, nazwisku, e-mailu lub mieście" /></div><div class="col"><button class="btn btn-primary">Szukaj</button> <a asp-action="Index" class="btn btn-secondary">Wyczyść</a></div></form>
<div class="table-responsive"><table class="table table-striped table-bordered align-middle"><thead><tr><th>Imię</th><th>Nazwisko</th><th>Telefon</th><th>E-mail</th><th>Miasto</th><th>Opcje</th></tr></thead><tbody>
@foreach (var k in Model) { <tr><td>@k.Imie</td><td>@k.Nazwisko</td><td>@k.Telefon</td><td>@k.Email</td><td>@k.Miasto</td><td><a asp-action="Szczegoly" asp-route-id="@k.Id" class="btn btn-sm btn-info">Podgląd</a> <a asp-action="Edytuj" asp-route-id="@k.Id" class="btn btn-sm btn-warning">Edytuj</a> <a asp-action="Usun" asp-route-id="@k.Id" class="btn btn-sm btn-danger">Usuń</a></td></tr> }
</tbody></table></div>
@if (!Model.Any()) { <div class="alert alert-light border">Brak klientów w bazie.</div> }
